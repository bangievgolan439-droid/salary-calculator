# Copy to .env and fill in to pull real historical bars from Alpaca's
# paper-trading data API. Without these, run_backtest.py falls back to
# a clearly-labeled synthetic price series so the backtest still runs.
# NEVER commit real keys, and never point this project at a live-trading
# key: it only reads historical data, it never places orders.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
